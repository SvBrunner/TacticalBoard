# Production gateway (docs/deployment.md, arc42 ch. 7): one origin for the whole app.
#   /api, /auth -> backend    everything else -> frontend
# TLS is terminated by the operator's reverse proxy in front of this gateway, which must pass
# X-Forwarded-Proto/-For. The gateway keeps those headers only from trusted proxies
# (GATEWAY_TRUSTED_PROXIES, default: private address ranges) and replaces them otherwise.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static {$GATEWAY_TRUSTED_PROXIES:private_ranges}
	}
}

:8080 {
	@backend path /api /api/* /auth /auth/*
	handle @backend {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:8080
	}
}
