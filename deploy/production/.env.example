# TacticalBoard production configuration for compose.yaml (docs/deployment.md).
# Copy to .env next to compose.yaml and fill in. Never commit the real .env.

# --- Images -------------------------------------------------------------------------------
# Image tag of ghcr.io/svbrunner/tacticalboard-backend and -frontend. Pin a release (e.g. 1.2.3,
# or 1.2 for its patch releases); "latest" is the newest build of master. Optional, default latest.
TACTICALBOARD_VERSION=latest

# --- Gateway (where your TLS-terminating reverse proxy connects) --------------------------
# Host address and port the gateway is published on. Optional, defaults 127.0.0.1 and 8080.
# Keep 127.0.0.1 when the reverse proxy runs on the same host.
TACTICALBOARD_HTTP_BIND=127.0.0.1
TACTICALBOARD_HTTP_PORT=8080
# Addresses (CIDR ranges, space-separated) whose X-Forwarded-* headers the gateway trusts, i.e.
# your reverse proxy. Optional, default private_ranges (all private and loopback addresses).
GATEWAY_TRUSTED_PROXIES=private_ranges

# --- Public URL ---------------------------------------------------------------------------
# REQUIRED. The URL users open (https, no trailing path, query or fragment).
# The OIDC redirect URIs are built from it: <PUBLIC_BASE_URL>/auth/callback and
# <PUBLIC_BASE_URL>/auth/signout-callback.
PUBLIC_BASE_URL=https://tacticalboard.example.org

# --- OpenID Connect provider --------------------------------------------------------------
# REQUIRED. The issuer URL of your provider (exactly as its discovery document's "issuer").
OIDC_AUTHORITY=https://id.example.org/realms/tacticalboard
# REQUIRED. The client ID registered for TacticalBoard at the provider.
OIDC_CLIENT_ID=tacticalboard
# Client secret of the confidential client (recommended). Leave empty only for a public client.
OIDC_CLIENT_SECRET=change-me
# Requested scopes, space-separated; must contain openid. Optional, default "openid profile email".
OIDC_SCOPE=openid profile email

# --- First system administrator -----------------------------------------------------------
# Identities that become system administrators: issuer|subject, several separated by ";".
# The issuer must equal OIDC_AUTHORITY's "issuer" exactly. Optional, default none.
BOOTSTRAP_SYSTEM_ADMINISTRATORS=https://id.example.org/realms/tacticalboard|00000000-0000-0000-0000-000000000000

# --- Database -----------------------------------------------------------------------------
# REQUIRED. Password of the PostgreSQL user "tacticalboard". Use letters and digits only (it is
# put into a connection string), e.g. the output of: openssl rand -hex 32
POSTGRES_PASSWORD=change-me

# --- Logging ------------------------------------------------------------------------------
# Minimum log level of the backend (Trace, Debug, Information, Warning, Error). Optional,
# default Information.
BACKEND_LOG_LEVEL=Information
