# Local development reverse proxy (arc42 ch. 7): one origin for the whole app.
#   /api, /auth -> backend    everything else -> frontend
# TLS is not terminated here in local development (plain http://localhost:8080).
{
	admin off
	auto_https off
}

:8080 {
	@backend path /api /api/* /auth /auth/*
	handle @backend {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:8080
	}
}
