      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Trainer",
      "credentials": [{ "type": "password", "value": "trainer", "temporary": false }]
    },
    {
      "id": "8f6d5f3e-4c1a-4b8e-9a51-0c7d2b6e1a02",
      "username": "player",
