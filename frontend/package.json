{
	"name": "tacticalboard",
	"version": "0.0.1",
	"//typescript": "pinned below 7.x in devDependencies: @sveltejs/kit and svelte-check don't declare peer support for TypeScript 7 yet",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^22.20.2",
		"jsdom": "^30.0.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	},
	"type": "module",
	"dependencies": {
		"canvas": "^3.2.3",
		"konva": "^10.5.0",
		"svelte-konva": "^1.0.1",
		"uuid": "^14.0.2"
	}
}
