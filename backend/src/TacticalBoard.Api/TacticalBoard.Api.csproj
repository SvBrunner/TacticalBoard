<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The host of the modular monolith: composes the modules, the shared infrastructure and the
    HTTP pipeline (Problem Details, health endpoint, BFF login). Also holds the EF Core migrations, because
    only the host knows every module's part of the model.
  -->
  <PropertyGroup>
    <RootNamespace>TacticalBoard.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TacticalBoard.SharedKernel\TacticalBoard.SharedKernel.csproj" />
    <ProjectReference Include="..\TacticalBoard.Infrastructure\TacticalBoard.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\TacticalBoard.Users\TacticalBoard.Users.csproj" />
    <ProjectReference Include="..\Modules\TacticalBoard.Teams\TacticalBoard.Teams.csproj" />
    <ProjectReference Include="..\Modules\TacticalBoard.Areas\TacticalBoard.Areas.csproj" />
    <ProjectReference Include="..\Modules\TacticalBoard.Folders\TacticalBoard.Folders.csproj" />
    <ProjectReference Include="..\Modules\TacticalBoard.Situations\TacticalBoard.Situations.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TacticalBoard.UnitTests" />
    <InternalsVisibleTo Include="TacticalBoard.IntegrationTests" />
  </ItemGroup>
</Project>
